{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pingo",
  "version": "0.6.0",
  "identifier": "com.pedrosilva.financas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pingo",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "pingo"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "pingo"
        ]
      }
    }
  }
}
